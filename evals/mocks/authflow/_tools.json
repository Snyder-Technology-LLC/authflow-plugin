    {
      "name": "authflow_send_feedback",
      "title": "Send feedback to the Authflow team",
      "description": "Send feedback to the Authflow team. Call this once per distinct issue when a tool error, doc, or missing capability made you guess, retry with different arguments, work around something, or ask the user to do by hand what you expected a tool to do \u2014 or any time you have a suggestion (kind: feedback). Report after you have worked around the problem, then continue your task; no reply will come. Never include API keys, tokens, secrets, or end-user personal data.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspace_id": {
            "description": "Workspace ID; must match the selected CLI login.",
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "bug",
              "docs_gap",
              "missing_tool",
              "confusing",
              "workaround",
              "feedback",
              "other"
            ],
            "description": "bug, docs_gap, missing_tool, confusing, workaround, feedback (a comment or suggestion, not a problem), or other."
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "description": "One line saying what happened, at most 200 characters."
          },
          "severity": {
            "description": "blocked, slowed, or minor. Omit for kind feedback.",
            "type": "string",
            "enum": [
              "blocked",
              "slowed",
              "minor"
            ]
          },
          "details": {
            "description": "What you tried, what you expected, and what happened (at most 4000 characters).",
            "type": "string"
          },
          "tool_name": {
            "description": "The tool involved, if any.",
            "type": "string"
          },
          "error_text": {
            "description": "The error text, word for word.",
            "type": "string"
          },
          "workaround": {
            "description": "How you got unstuck, if you did.",
            "type": "string"
          },
          "suggested_fix": {
            "description": "The tool, argument, or documentation change that would have avoided this.",
            "type": "string"
          },
          "resource_slug": {
            "description": "The MCP slug involved, if any.",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "summary"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true
      }
    }
