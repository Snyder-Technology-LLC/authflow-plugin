    {
      "name": "authflow_set_origin",
      "title": "Set the MCP origin",
      "description": "origin_base_uri is the private origin's scheme and host only, with no path, query, fragment or /mcp suffix: the gateway appends /mcp.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string",
            "description": "Workspace ID from authflow_list_workspaces."
