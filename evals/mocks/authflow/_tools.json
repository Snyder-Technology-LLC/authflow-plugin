    {
      "name": "authflow_set_custom_domain",
      "title": "Set the MCP custom hostname",
      "description": "Sets public_host (a subdomain you control) before first publication. public_path is optional: Rail uses /mcp the first time a host is set and keeps the stored path when it is omitted. This tool never clears a domain; to return to the slug URL, the owner runs authflow resource domain <slug> --file with {\"public_host\": null}.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string",
            "description": "Workspace ID from authflow_list_workspaces."
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
          },
          "public_host": {
            "type": "string",
            "minLength": 1
          },
          "public_path": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "workspace_id",
          "slug",
          "public_host"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "openWorldHint": true
      }
