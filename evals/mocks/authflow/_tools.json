    {
      "name": "authflow_create_resource",
      "title": "Create an unpublished MCP draft",
      "description": "Creates a free or paid draft, defaulting to gateway metering. Free and gateway-metered origins need no key. Paid origin_reported integrations require direct CLI secret-store delivery. Secrets are never returned in tool messages. Metering costs must be integers from 0 through 1,000,000. tool_units accepts at most 64 nonblank tool names of 1 through 128 characters; the serialized policy must fit within 8,192 characters.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string",
            "description": "Workspace ID from authflow_list_workspaces."
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "access_mode": {
            "type": "string",
            "enum": [
              "free",
              "paid"
            ]
          },
          "currency": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3
          },
          "price_amount_minor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "credits_per_period": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "metering_mode": {
            "type": "string",
            "enum": [
              "gateway_metered",
              "origin_reported"
            ]
          },
          "metering_default_units": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "tool_units": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "additionalProperties": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            }
          }
        },
        "required": [
          "workspace_id",
          "slug",
          "display_name",
          "access_mode"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "openWorldHint": true
      }
    },
    {
      "name": "authflow_update_resource",
      "title": "Update MCP name, offer, or metering",
      "description": "Omitted fields are preserved. A supplied tool_units map replaces all tool overrides. Policy changes invalidate verification and publication; verify and explicitly republish. Metering costs must be integers from 0 through 1,000,000. tool_units accepts at most 64 nonblank tool names of 1 through 128 characters; the serialized policy must fit within 8,192 characters.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "workspace_id": {
            "type": "string",
            "description": "Workspace ID from authflow_list_workspaces."
          },
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
          },
          "display_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "access_mode": {
            "type": "string",
            "enum": [
              "free",
              "paid"
            ]
          },
          "currency": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3
          },
          "price_amount_minor": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "credits_per_period": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "metering_mode": {
            "type": "string",
            "enum": [
              "gateway_metered",
              "origin_reported"
            ]
          },
          "metering_default_units": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000
          },
          "tool_units": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "additionalProperties": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            }
          }
        },
        "required": [
          "workspace_id",
          "slug"
        ],
        "$schema": "http://json-schema.org/draft-07/schema#"
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "openWorldHint": true
      }
